# Copy to .env (never commit .env). CI gets these from GitHub secrets/vars (scripts/setup-secrets.sh).
BASE_URL=https://app.stonewake.ai
TEST_USER=
TEST_PASSWORD=
# API base (requests use /health and /v1/... relative to it)
API_URL=https://api.stonewake.ai
# Stonewake REST API key of our own workspace (Bearer, role viewer). Placeholder only: real value in .env / GitHub secrets.
STONEWAKE_API_KEY=
# testIdAttribute the product uses (data-testid, data-test, data-qa ...)
TEST_ID_ATTRIBUTE=data-testid
# off | log | strict  (strict = a heal fails the test; used by the stability gate)
HEAL_MODE=log
# Unique per run; CI sets ${run_id}-${n}
RUN_ID=
# Triage / notifications / bug filing
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
SLACK_WEBHOOK_URL=
SPIRA_URL=
SPIRA_USER=
SPIRA_API_KEY=
SPIRA_PROJECT_ID=
